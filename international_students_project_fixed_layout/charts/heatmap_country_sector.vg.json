{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Top source countries by education sector, January 2026",
  "width": 760,
  "height": 350,
  "data": {
    "url": "data/top10_country_sector_latest.csv"
  },
  "mark": "rect",
  "encoding": {
    "x": {
      "field": "Sector",
      "type": "nominal",
      "title": "Sector",
      "axis": {
        "labelAngle": -25
      }
    },
    "y": {
      "field": "Nationality",
      "type": "nominal",
      "title": "Source country"
    },
    "color": {
      "field": "Students",
      "type": "quantitative",
      "title": "Students",
      "scale": {
        "scheme": "yellowgreenblue"
      }
    },
    "tooltip": [
      {
        "field": "Nationality"
      },
      {
        "field": "Sector"
      },
      {
        "field": "Students",
        "type": "quantitative",
        "format": ","
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "gridColor": "#e5e0d6",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "title": {
      "font": "Arial",
      "fontSize": 15,
      "anchor": "start",
      "fontWeight": "bold"
    }
  }
}