{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Raw student counts vs per-capita rates",
  "width": 500,
  "height": 330,
  "data": {
    "url": "data/students_by_state_latest.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "circle",
        "size": 135,
        "opacity": 0.75,
        "color": "#2f6f9f"
      },
      "encoding": {
        "x": {
          "field": "Students",
          "type": "quantitative",
          "title": "Students",
          "axis": {
            "format": "~s"
          }
        },
        "y": {
          "field": "Students_per_100k",
          "type": "quantitative",
          "title": "Students per 100k residents"
        },
        "tooltip": [
          {
            "field": "State_Name",
            "title": "State"
          },
          {
            "field": "Students",
            "type": "quantitative",
            "format": ","
          },
          {
            "field": "Students_per_100k",
            "type": "quantitative",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 10
      },
      "encoding": {
        "x": {
          "field": "Students",
          "type": "quantitative",
          "title": "Students",
          "axis": {
            "format": "~s"
          }
        },
        "y": {
          "field": "Students_per_100k",
          "type": "quantitative",
          "title": "Students per 100k residents"
        },
        "text": {
          "field": "State",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "State_Name",
            "title": "State"
          },
          {
            "field": "Students",
            "type": "quantitative",
            "format": ","
          },
          {
            "field": "Students_per_100k",
            "type": "quantitative",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "gridColor": "#e5e0d6",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "title": {
      "font": "Arial",
      "fontSize": 15,
      "anchor": "start",
      "fontWeight": "bold"
    }
  }
}