{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Students by education sector, January snapshots",
  "width": 900,
  "height": 360,
  "data": {
    "url": "data/students_by_sector_time_jan.csv"
  },
  "params": [
    {
      "name": "Sector_highlight",
      "select": {
        "type": "point",
        "fields": [
          "Sector"
        ]
      },
      "bind": "legend"
    }
  ],
  "mark": {
    "type": "area"
  },
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "title": "Year",
      "axis": {
        "labelAngle": 0
      }
    },
    "y": {
      "field": "Students",
      "type": "quantitative",
      "stack": "zero",
      "title": "Students",
      "axis": {
        "format": "~s"
      }
    },
    "color": {
      "field": "Sector",
      "type": "nominal",
      "title": "Sector",
      "scale": {
        "range": [
          "#2f6f9f",
          "#7bb274",
          "#f2ce62",
          "#f28e8e",
          "#9b86bd"
        ]
      }
    },
    "opacity": {
      "condition": {
        "param": "Sector_highlight",
        "value": 0.95
      },
      "value": 0.25
    },
    "tooltip": [
      {
        "field": "Year"
      },
      {
        "field": "Sector"
      },
      {
        "field": "Students",
        "type": "quantitative",
        "format": ","
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "gridColor": "#e5e0d6",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "title": {
      "font": "Arial",
      "fontSize": 15,
      "anchor": "start",
      "fontWeight": "bold"
    }
  }
}