{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "How the 2026 top 10 source countries moved in rank",
    "subtitle": "Rank 1 = largest source country. Some 2026 top-10 countries were outside the top 10 in earlier years."
  },
  "width": 920,
  "height": 440,
  "data": {
    "url": "data/top_country_rank_time_jan.csv"
  },
  "transform": [
    {
      "filter": "isValid(datum.Rank) && datum.Rank > 0"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 55
        },
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "title": "Year",
          "sort": "ascending",
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "Rank",
          "type": "quantitative",
          "title": "Rank",
          "scale": {
            "reverse": true,
            "zero": false,
            "nice": false
          },
          "axis": {
            "tickMinStep": 1
          }
        },
        "color": {
          "field": "Nationality",
          "type": "nominal",
          "title": "Country"
        },
        "order": {
          "field": "Year",
          "type": "ordinal"
        },
        "tooltip": [
          {
            "field": "Year",
            "type": "ordinal"
          },
          {
            "field": "Nationality",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "Rank",
            "type": "quantitative"
          },
          {
            "field": "Students",
            "type": "quantitative",
            "format": ","
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "Rank": 10
          }
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#999",
        "strokeDash": [4, 4],
        "strokeWidth": 1
      },
      "encoding": {
        "y": {
          "field": "Rank",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "Year": 2026,
            "Rank": 10,
            "Label": "Top 10 cut-off"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "dy": -6,
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#666"
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal"
        },
        "y": {
          "field": "Rank",
          "type": "quantitative"
        },
        "text": {
          "field": "Label"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "gridColor": "#e5e0d6",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "title": {
      "font": "Arial",
      "fontSize": 15,
      "anchor": "start",
      "fontWeight": "bold"
    }
  }
}