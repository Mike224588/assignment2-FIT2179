{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Top 5 source countries as a share of all students, January 2026",
  "width": 430,
  "height": 340,
  "data": {
    "url": "data/top5_waffle.csv"
  },
  "mark": {
    "type": "square",
    "size": 430
  },
  "encoding": {
    "x": {
      "field": "col",
      "type": "ordinal",
      "axis": null
    },
    "y": {
      "field": "row",
      "type": "ordinal",
      "axis": null
    },
    "color": {
      "field": "Category",
      "type": "nominal",
      "title": "Country group",
      "scale": {
        "range": [
          "#7bb274",
          "#7aa6c2",
          "#f2ce62",
          "#f28e8e",
          "#f4a65d",
          "#c9c9c9"
        ]
      },
      "legend": {
        "orient": "right",
        "title": "Country group"
      }
    },
    "tooltip": [
      {
        "field": "Category",
        "type": "nominal"
      },
      {
        "field": "Students",
        "type": "quantitative",
        "format": ","
      },
      {
        "field": "Share",
        "type": "quantitative",
        "format": ".1f",
        "title": "Share of total (%)"
      },
      {
        "field": "Cell_Count",
        "type": "quantitative",
        "title": "Approx. cells out of 100"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "gridColor": "#e5e0d6",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "title": {
      "font": "Arial",
      "fontSize": 15,
      "anchor": "start",
      "fontWeight": "bold"
    }
  }
}