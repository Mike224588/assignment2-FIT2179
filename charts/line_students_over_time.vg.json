{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "International students in Australia, January snapshots",
  "width": 900,
  "height": 340,
  "data": {
    "url": "data/students_by_year_jan.csv"
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": true,
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "title": "Year",
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "Students",
          "type": "quantitative",
          "title": "Students at 1 January",
          "axis": {
            "format": "~s"
          },
          "scale": {
            "zero": false
          }
        },
        "tooltip": [
          {
            "field": "Year"
          },
          {
            "field": "Students",
            "type": "quantitative",
            "format": ","
          },
          {
            "field": "YTD_Enrolments",
            "type": "quantitative",
            "format": ",",
            "title": "YTD enrolments"
          },
          {
            "field": "YTD_Commencements",
            "type": "quantitative",
            "format": ",",
            "title": "YTD commencements"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.Year == 2022 || datum.Year == 2025"
        },
        {
          "calculate": "datum.Year == 2022 ? 'Lowest January snapshot' : 'Peak before 2026 decline'",
          "as": "Annotation"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 8,
        "dy": -10,
        "fontSize": 11,
        "fontStyle": "italic"
      },
      "encoding": {
        "x": {
          "field": "Year",
          "type": "ordinal",
          "axis": {
            "labelAngle": 0
          }
        },
        "y": {
          "field": "Students",
          "type": "quantitative",
          "scale": {
            "zero": false
          }
        },
        "text": {
          "field": "Annotation"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "gridColor": "#e5e0d6",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelFont": "Arial",
      "titleFont": "Arial",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "title": {
      "font": "Arial",
      "fontSize": 15,
      "anchor": "start",
      "fontWeight": "bold"
    }
  }
}